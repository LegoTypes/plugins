#!/bin/sh
# A real removal takes the plugin's keys out of core's MAC alias cache, as turning the setting off does, and core's
# next minute run takes their addresses out of the aliases. Left there, they would feed the aliases for up to 12 hours
# with no page left to remove them. An upgrade keeps them.
macalias_script=/usr/local/opnsense/scripts/OPNsense/MacAliasCache/macalias.py
macalias_conf=/usr/local/etc/macaliascache.conf
if [ -z "${PKG_UPGRADE:-}" ] && [ -x "$macalias_script" ]; then
    # The setting goes off in the rendered file first: a tick cron starts before pkg removes the cron file then removes
    # the keys too, instead of adding them again. +POST_DEINSTALL.post removes the file; the saved setting stays.
    printf '[general]\nneighbors=0\n' > "$macalias_conf" || true
    # The removal itself waits 10 s for a tick that is running and 5 s for core's lock. Core's own alias update can
    # hold its lock for longer, so a busy answer is asked again, twice, 2 s apart.
    macalias_reply=
    for macalias_attempt in 1 2 3; do
        macalias_reply=$("$macalias_script" neighbors remove 2> /dev/null) || true
        case "$macalias_reply" in
            *'"error": "busy"'*) [ "$macalias_attempt" = 3 ] || sleep 2 ;;
            *) break ;;
        esac
    done
    # pkg shows what a script prints: one line when the keys stay, whatever the reason
    case "$macalias_reply" in
        *'"result": "ok"'*) ;;
        *) echo "os-mac-alias-cache: the plugin's keys were not removed from core's MAC alias cache and expire there" \
            "within 12 hours: ${macalias_reply:-no reply}" ;;
    esac
fi
