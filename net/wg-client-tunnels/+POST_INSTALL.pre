
# An install after a removal that stopped partway: its marker would keep every entry point of the plugin stopped,
# so it goes first, before the configure steps the package appends to this script.
rm -f /var/run/wgclienttunnels/removing
# The IPv6 monitor repair's state, from a release before 3.10, which retired the repair.
rm -f /var/run/wgclienttunnels/monitor_repair.json /var/run/wgclienttunnels/monitor_repair.lock
