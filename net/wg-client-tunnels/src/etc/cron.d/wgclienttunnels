# WireGuard tunnel health mirror: holds each tunnel down while its bound WAN is
# down, and each IPv6 tunnel gateway down while its own IPv4 tunnel is
* * * * *	root	/usr/local/bin/php /usr/local/opnsense/scripts/OPNsense/WGClientTunnels/health_mirror.php
* * * * *	root	sleep 15 && /usr/local/bin/php /usr/local/opnsense/scripts/OPNsense/WGClientTunnels/health_mirror.php
* * * * *	root	sleep 30 && /usr/local/bin/php /usr/local/opnsense/scripts/OPNsense/WGClientTunnels/health_mirror.php
* * * * *	root	sleep 45 && /usr/local/bin/php /usr/local/opnsense/scripts/OPNsense/WGClientTunnels/health_mirror.php

# Route reconciliation safety net. The event hooks in plugins.inc.d cover the
# known ways the gateway host routes get dropped; this catches anything that
# removes them without firing a hook, so a lost route self-heals within a minute
# instead of sitting broken until someone notices the gateway is down. It also
# runs default_guard.php, which removes any default route through a tunnel.
* * * * *	root	/usr/local/opnsense/scripts/OPNsense/WGClientTunnels/wgct.sh reconcile
