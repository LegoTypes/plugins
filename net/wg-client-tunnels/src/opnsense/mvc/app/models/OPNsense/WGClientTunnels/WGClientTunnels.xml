<model>
    <mount>//OPNsense/WGClientTunnels</mount>
    <version>2.1.0</version>
    <description>WireGuard IPv6 Gateway companion settings</description>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <health_mirror type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </health_mirror>
        <ipv6_routes type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </ipv6_routes>
        <default_guard type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </default_guard>
        <wan_pins type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </wan_pins>
        <inner_source type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </inner_source>
        <mss_clamp type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </mss_clamp>
        <!-- WireGuard instance UUIDs the plugin manages; written by the
             migration, the tunnel scripts and (from S3) Create/Adopt/Remove -->
        <managed type="CSVListField">
            <Mask>/^[0-9a-fA-F-]{36}$/</Mask>
            <MaskPerItem>Y</MaskPerItem>
        </managed>
        <!-- gateway UUIDs the health mirror forced down (it releases only these) -->
        <held type="CSVListField">
            <Mask>/^[0-9a-fA-F-]{36}$/</Mask>
            <MaskPerItem>Y</MaskPerItem>
        </held>
    </items>
</model>
