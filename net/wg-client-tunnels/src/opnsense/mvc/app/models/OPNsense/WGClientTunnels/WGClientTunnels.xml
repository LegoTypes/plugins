<model>
    <mount>//OPNsense/WGClientTunnels</mount>
    <version>3.0.0</version>
    <description>WireGuard client tunnels settings</description>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <health_mirror type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </health_mirror>
        <ipv6_routes type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </ipv6_routes>
        <default_guard type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </default_guard>
        <wan_pins type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </wan_pins>
        <inner_source type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </inner_source>
        <mss_clamp type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </mss_clamp>
        <!-- WireGuard instance UUIDs the plugin manages; written by Create,
             Adopt and Remove, and by the 3.0.0 migration from the 2.x plugin -->
        <managed type="CSVListField">
            <Mask>/^[0-9a-fA-F-]{36}$/</Mask>
            <MaskPerItem>Y</MaskPerItem>
        </managed>
        <!-- gateway UUIDs the health mirror forced down (it releases only these) -->
        <held type="CSVListField">
            <Mask>/^[0-9a-fA-F-]{36}$/</Mask>
            <MaskPerItem>Y</MaskPerItem>
        </held>
    </items>
</model>
