<model>
    <mount>//OPNsense/WanFailover</mount>
    <version>1.0.0</version>
    <description>WAN failover settings</description>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <dry type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </dry>
        <wans type="ModelRelationField">
            <Model>
                <gateways>
                    <source>OPNsense.Routing.Gateways</source>
                    <items>gateway_item</items>
                    <display>name</display>
                    <filters>
                        <ipprotocol>/^inet$/</ipprotocol>
                    </filters>
                </gateways>
            </Model>
            <Multiple>Y</Multiple>
            <ValidationMessage>Select saved IPv4 gateways.</ValidationMessage>
        </wans>
        <failback type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </failback>
        <failback_delay type="IntegerField">
            <Default>10</Default>
            <Required>Y</Required>
            <MinimumValue>0</MinimumValue>
            <MaximumValue>120</MaximumValue>
            <ValidationMessage>Enter whole minutes from 0 to 120.</ValidationMessage>
        </failback_delay>
        <tailscale_restart type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </tailscale_restart>
    </items>
</model>
