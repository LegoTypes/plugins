#
# Config-change hook: a config revert or restore can change force_down or the plugin's hold records
# without reconfiguring routing; an evaluation notices and re-syncs. Detached and
# idempotent, so the plugin's own saves do not loop.

/usr/local/sbin/configctl -d wanfailover evaluate > /dev/null 2>&1
exit 0
