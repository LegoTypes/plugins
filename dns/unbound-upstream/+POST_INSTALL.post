
# An install or an upgrade (its deinstall dropped the rendered rules and the minute job, and left the removal
# marker that keeps evaluations stopped) deletes the marker, loads the plugin's rules and, while it is enabled,
# its minute job back; nothing else starts.
rm -f /var/run/unboundupstream/removing
/usr/local/sbin/configctl filter reload || true
/usr/local/sbin/configctl cron restart || true
