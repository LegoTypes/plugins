<model>
    <mount>//OPNsense/UnboundUpstream</mount>
    <version>1.0.0</version>
    <description>Unbound upstream via gateway group settings</description>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <dry_run type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </dry_run>
        <!-- stores the group's UUID; the snapshot resolves it to the group name. Required when enabled:
             checked in the model class -->
        <gateway_group type="ModelRelationField">
            <Model>
                <groups>
                    <source>OPNsense.Routing.GatewayGroups</source>
                    <items>gateway_group</items>
                    <display>name</display>
                </groups>
            </Model>
            <ValidationMessage>Select a saved gateway group.</ValidationMessage>
        </gateway_group>
        <!-- the Default resolver: either family, checked against the group in the model class -->
        <resolver type="NetworkField">
            <NetMaskAllowed>N</NetMaskAllowed>
            <ValidationMessage>Enter a single IPv4 or IPv6 address.</ValidationMessage>
        </resolver>
        <!-- one optional resolver per group member; the gateway column stores the gateway's UUID -->
        <resolvers>
            <resolver type="ArrayField">
                <gateway type="ModelRelationField">
                    <Model>
                        <gateways>
                            <source>OPNsense.Routing.Gateways</source>
                            <items>gateway_item</items>
                            <display>name</display>
                        </gateways>
                    </Model>
                    <Required>Y</Required>
                    <ValidationMessage>Select a gateway.</ValidationMessage>
                </gateway>
                <address type="NetworkField">
                    <NetMaskAllowed>N</NetMaskAllowed>
                    <Required>Y</Required>
                    <ValidationMessage>Enter a single IPv4 or IPv6 address.</ValidationMessage>
                </address>
            </resolver>
        </resolvers>
        <failback_delay type="IntegerField">
            <Default>120</Default>
            <Required>Y</Required>
            <MinimumValue>60</MinimumValue>
            <MaximumValue>3600</MaximumValue>
            <ValidationMessage>Enter whole seconds from 60 to 3600.</ValidationMessage>
        </failback_delay>
        <!-- off: every client gets REFUSED while no member is usable -->
        <fallback type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </fallback>
        <!-- checked in the model class (checkFailClosed) while fallback is on -->
        <fail_closed type="InterfaceField">
            <Multiple>Y</Multiple>
        </fail_closed>
        <!-- not Multiple: NetworkField is a BaseSetField, which takes lists through AsList -->
        <fail_closed_networks type="NetworkField">
            <AsList>Y</AsList>
            <FieldSeparator>,</FieldSeparator>
            <NetMaskRequired>Y</NetMaskRequired>
            <Strict>Y</Strict>
            <ValidationMessage>Enter each network with its prefix length and no host bits, for example 100.64.0.0/10.</ValidationMessage>
        </fail_closed_networks>
        <notify type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </notify>
        <!-- required when notify is on: checked in the model class -->
        <notify_url type="UrlField">
            <ValidationMessage>Enter an http or https URL.</ValidationMessage>
        </notify_url>
    </items>
</model>
