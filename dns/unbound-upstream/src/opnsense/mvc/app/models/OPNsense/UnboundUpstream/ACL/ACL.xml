<acl>
    <page-services-unboundupstream>
        <name>Services: Unbound DNS: Upstream via Gateway</name>
        <patterns>
            <pattern>ui/unboundupstream/*</pattern>
            <pattern>api/unboundupstream/*</pattern>
            <pattern>ui/diagnostics/log/core/unboundupstream*</pattern>
            <pattern>api/diagnostics/log/core/unboundupstream*</pattern>
        </patterns>
    </page-services-unboundupstream>
    <page-status-unboundupstream>
        <name>Status: Unbound DNS: Upstream via Gateway (API)</name>
        <patterns>
            <pattern>api/unboundupstream/service/state</pattern>
        </patterns>
    </page-status-unboundupstream>
</acl>
